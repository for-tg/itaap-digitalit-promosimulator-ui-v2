{
  "name": "promo-simulator-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open --port 3003  --strictPort true",
    "build:local": "tsc && vite build",
    "build:dev-acc-prod": "tsc && vite build --base /eks/application/path",
    "build:test": "tsc && vite build --base /eks/application/path",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "ci:lint": "eslint . --format html -o eslint-out.html",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format-check": "prettier . --check"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.21.0",
    "@azure/msal-react": "^3.0.19",
    "@filament-icons/react": "^1.19.1",
    "@filament/react": "^3.19.0",
    "@vanilla-extract/css": "^1.17.4",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@filament/vite-plugin": "^3.3.29",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.3.5",
    "vite-plugin-checker": "^0.10.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
